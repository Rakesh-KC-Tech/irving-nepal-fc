# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER expose with NEXT_PUBLIC_. Used by
# the Stripe webhook, which has no logged-in user to authenticate as.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth email redirect links.
# Local dev: http://localhost:3000
# Production: https://portal.irvingnepalfc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (use test mode keys — Developers → API keys in the Stripe dashboard)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint's "Signing secret" once created in Stripe.
STRIPE_WEBHOOK_SECRET=

# The static marketing site's origin (irvingnepalfc.com). Used by
# /api/store-checkout for CORS and Stripe success/cancel redirect URLs.
# Defaults to https://irvingnepalfc.com if unset.
STORE_SITE_URL=https://irvingnepalfc.com

# ClubVerse Partner API key (https://clubverseapp.com/api/partner/v1/docs).
# Issued per-club by ClubVerse, starts with cvk_. Keep this server-side only
# — never send it to the browser or commit a real value here.
CLUBVERSE_API_KEY=
