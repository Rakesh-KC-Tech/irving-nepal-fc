# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER expose with NEXT_PUBLIC_. Used for
# admin-only server actions that must bypass RLS (e.g. approving members).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth email redirect links.
# Local dev: http://localhost:3000
# Production: https://portal.irvingnepalfc.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
